<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>B2BStore.TechnicalSettings.Api</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <UserSecretsId>b2bstore-teknik-ayarlar-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.*" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.*" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.*" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Catalog\settings-catalog.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
